artifacts/api-server/src/**/*.d.ts.map
lib/*/src/**/*.js
lib/*/src/**/*.js.map
lib/*/src/**/*.d.ts
lib/*/src/**/*.d.ts.map
api/**/*.js
api/**/*.js.map

# Env files
.env
.env.local
.env.*.local

